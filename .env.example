# FreshCut API — local environment
#
# Copy to `.env` and adjust as needed:
#   cp .env.example .env
#
# The API does not read .env on its own. Load it explicitly, e.g.:
#   node --env-file=.env server/index.js     # Node 22
# or export the variables in your shell. Docker Compose reads it via `env_file:`.
# Every value below has a safe default in code, so the API still boots with this
# file missing or empty.

# Port the Express API listens on. The Vite dev server proxies /api here.
PORT=8001

# Secret used to sign and verify login JWTs. REQUIRED in production —
# dev-only fallback is "freshcut-dev-secret". Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# OPTIONAL — enables the manager dashboard's Google Sheets work-order import.
# Spreadsheet ID from docs.google.com/spreadsheets/d/<ID>/edit, shared as
# "Anyone with the link -> Viewer". Leave as `placeholder` (or unset) to
# disable the import; nothing else depends on it.
GOOGLE_SHEETS_SPREADSHEET_ID=placeholder
